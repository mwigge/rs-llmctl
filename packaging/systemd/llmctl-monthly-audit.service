[Unit]
Description=Write rs-llmctl monthly audit evidence
Documentation=https://github.com/mwigge/rs-llmctl

[Service]
Type=oneshot
User=llmctl
Group=llmctl
Environment=LLMCTL_CONFIG=/etc/rs-llmctl/config.toml
ExecStart=/usr/local/bin/llmctl --config ${LLMCTL_CONFIG} audit report monthly --envelope --write
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rs-llmctl /var/log/rs-llmctl
